{
  "manifest_version": 3,
  "name": "Arena Agent Turn Notifier",
  "version": "1.0.0",
  "description": "Shows a browser notification and plays a chime when an Arena agent finishes a turn.",
  "permissions": ["notifications", "offscreen", "storage"],
  "host_permissions": ["https://arena.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/agent/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Arena Agent Turn Notifier",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
